<?xml version="1.0" encoding="utf-8" ?>
<component name="FlightScreen" extends="Group">
  <interface>
    <field id="journeyConfig" type="assocarray" onChange="OnJourneyConfigChanged" />
    <field id="journeyCompleted" type="assocarray" alwaysNotify="true" />
    <field id="checkpointUpdated" type="assocarray" alwaysNotify="true" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/FlightScreen.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x030817FF" />
    <Label id="missionTitle" translation="[90,55]" width="1740" height="70" horizAlign="center" font="font:LargeBoldSystemFont" color="0x83F3FFFF" />
    <Label id="missionStatus" translation="[120,145]" width="1680" height="55" horizAlign="center" font="font:MediumSystemFont" />

    <Rectangle id="lane" translation="[180,260]" width="1560" height="540" color="0x0B2440FF" />
    <Rectangle id="ship" translation="[920,690]" width="90" height="70" color="0x71F7D4FF" />

    <Rectangle id="beacon0" translation="[390,350]" width="70" height="70" color="0xFFE68AFF" />
    <Rectangle id="beacon1" translation="[925,430]" width="70" height="70" color="0xFFE68AFF" />
    <Rectangle id="beacon2" translation="[1450,330]" width="70" height="70" color="0xFFE68AFF" />

    <Label id="beaconLabel0" text="1" translation="[390,360]" width="70" height="45" horizAlign="center" font="font:MediumBoldSystemFont" color="0x07111FFF" />
    <Label id="beaconLabel1" text="2" translation="[925,440]" width="70" height="45" horizAlign="center" font="font:MediumBoldSystemFont" color="0x07111FFF" />
    <Label id="beaconLabel2" text="3" translation="[1450,340]" width="70" height="45" horizAlign="center" font="font:MediumBoldSystemFont" color="0x07111FFF" />

    <Label id="prompt" translation="[250,825]" width="1420" height="70" horizAlign="center" wrap="true" font="font:MediumBoldSystemFont" />
    <Label id="companionReaction" translation="[300,900]" width="1320" height="55" horizAlign="center" wrap="true" font="font:SmallSystemFont" color="0x9DF5B8FF" />
    <Label text="LEFT / RIGHT steer - OK scans beacon - BACK aborts safely" translation="[390,985]" width="1140" height="45" horizAlign="center" font="font:SmallSystemFont" color="0xB7C9D6FF" />

    <Group id="summaryGroup" visible="false">
      <Rectangle translation="[330,180]" width="1260" height="720" color="0x102238FF" />
      <Label text="Journey Complete" translation="[420,230]" width="1080" height="80" horizAlign="center" font="font:LargeBoldSystemFont" color="0xFFE68AFF" />
      <Label id="summaryText" translation="[470,350]" width="980" height="360" wrap="true" font="font:MediumSystemFont" />
      <Label id="summaryReaction" translation="[470,735]" width="980" height="70" horizAlign="center" wrap="true" font="font:MediumBoldSystemFont" color="0x9DF5B8FF" />
      <Rectangle translation="[760,830]" width="400" height="90" color="0x2F8F83FF" />
      <Label text="Continue" translation="[760,850]" width="400" height="50" horizAlign="center" font="font:MediumBoldSystemFont" />
    </Group>
  </children>
</component>
